#!/usr/bin/env bash
set -euo pipefail

# Supported Compose filenames and extensions (in search priority order)
COMPOSE_FILES=("docker-compose" "compose")
COMPOSE_EXT=("yml" "yaml")
DEFAULT_COMPOSE_FILE="docker-compose.yml"
DEFAULT_LOG_SERVICE="app"

# Root directory containing project directories
DirEnv="${d_docker_comp:?d_docker_comp is not set}"
dir="$DirEnv"
parameter="${1:-}"
name=("${@:2}")
OPTS=(--log-level error)

if command -v docker-compose >/dev/null 2>&1; then
    docker_compose=(docker-compose)
else
    docker_compose=(docker "${OPTS[@]}" compose)
    if [[ -z "${NOCOMPOSE+x}" ]]; then
        echo "No docker-compose installed. Using docker compose plugin."
        echo "Set NOCOMPOSE to suppress this message."
    fi
fi

find_compose_file() {
    local project="$1" file ext path
    for file in "${COMPOSE_FILES[@]}"; do
        for ext in "${COMPOSE_EXT[@]}"; do
            path="$dir/$project/$file.$ext"
            if [[ -f "$path" ]]; then
                printf '%s\n' "$path"
                return 0
            fi
        done
    done
    return 1
}

checkstat() {
    local project="$1"
    if [[ ! -d "$dir/$project" ]]; then
        echo "Project '$project' not found!" >&2
        return 1
    fi
    if ! find_compose_file "$project" >/dev/null; then
        echo "No Compose file found for '$project'!" >&2
        return 1
    fi
}

compose_run() {
    local project="$1" compose_file
    shift
    checkstat "$project" || return 1
    compose_file="$(find_compose_file "$project")"
    (
        cd "$dir/$project"
        "${docker_compose[@]}" --file "$compose_file" "$@"
    )
}

edit_compose() {
    local project="$1" compose_file yn
    if [[ ! -d "$dir/$project" ]]; then
        echo "Do you want to create a new project named '$project'?"
        select yn in Yes No; do
            case "$yn" in
                Yes) mkdir -p -- "$dir/$project"; break ;;
                No) return 0 ;;
            esac
        done
    fi
    compose_file="$(find_compose_file "$project")" || compose_file="$dir/$project/$DEFAULT_COMPOSE_FILE"
    "${EDITOR:-vi}" "$compose_file"
}

require_projects() {
    if (( ${#name[@]} == 0 )); then
        echo "No projects specified." >&2
        exit 1
    fi
}

confirm() {
    local message="$1" answer
    read -r -p "$message [y/N]: " answer || return 1
    [[ "$answer" =~ ^([yY]|[yY][eE][sS])$ ]]
}

case "$parameter" in
    mod)
        "${EDITOR:-vi}" "$0"
        ;;
    delete|rm)
        require_projects
        for i in "${name[@]}"; do
            if [[ ! -d "$dir/$i" ]]; then
                echo "Project '$i' not found!" >&2
                continue
            fi
            echo "WARNING: This will permanently delete '$dir/$i'!"
            if confirm "Delete project '$i'?"; then
                rm -rf -- "$dir/$i"
                echo "Deleted: $i"
            else
                echo "Skipped: $i"
            fi
        done
        ;;
    edit)
        require_projects
        for i in "${name[@]}"; do edit_compose "$i"; done
        ;;
    cat|ls|list)
        require_projects
        for i in "${name[@]}"; do
            checkstat "$i"
            compose_file="$(find_compose_file "$i")"
            echo "=== $i ==="
            cat -- "$compose_file"
        done
        ;;
    status|ps)
        require_projects
        for i in "${name[@]}"; do
            echo "=== $i ==="
            compose_run "$i" ps
        done
        ;;
    log|logs)
        require_projects
        project="${name[0]}"
        follow_args=(-f)
        services=()
        no_follow=false

        # Accept -N/--no-follow after the project, including at the end.
        for arg in "${name[@]:1}"; do
            case "$arg" in
                -N|--no-follow) no_follow=true ;;
                -*)
                    echo "Unknown log option: $arg" >&2
                    exit 2
                    ;;
                *) services+=("$arg") ;;
            esac
        done

        if [[ "$no_follow" == true ]]; then
            follow_args=()
        fi

        if [[ "$parameter" == log ]]; then
            if (( ${#services[@]} > 1 )); then
                echo "'log' accepts only one service. Use 'logs' for multiple services." >&2
                exit 2
            fi
            compose_run "$project" logs "${follow_args[@]}" "${services[0]:-$DEFAULT_LOG_SERVICE}"
        else
            compose_run "$project" logs "${follow_args[@]}" "${services[@]}"
        fi
        ;;
    start|up)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" up -d; done
        ;;
    restart|reload)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" restart; done
        ;;
    recreate|rebuild)
        require_projects
        for i in "${name[@]}"; do
            compose_run "$i" down
            compose_run "$i" up -d
        done
        ;;
    stop)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" stop; done
        ;;
    remove|down)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" down; done
        ;;
    purge)
        require_projects
        for i in "${name[@]}"; do
            checkstat "$i"
            echo "WARNING: This will remove containers and volumes for '$i'!"
            echo "Persistent data stored in Docker volumes may be permanently lost."
            if confirm "Purge project '$i'?"; then
                compose_run "$i" down -v --remove-orphans
            else
                echo "Skipped: $i"
            fi
        done
        ;;
    pause|halt)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" pause; done
        ;;
    unpause|unhalt)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" unpause; done
        ;;
    pull)
        require_projects
        for i in "${name[@]}"; do compose_run "$i" pull; done
        ;;
    -h|--help|-?|-u|--usage|"")
        cat <<HELP
COMP – Compose Organization and Management Program

Usage: $0 <action> <project...>

Actions:
  edit                 Edit or create Compose configuration
  delete, rm           Delete project directory (confirmation required)
  cat, ls, list        Display Compose configuration
  status, ps           Show project container status
  log <project> [svc] [-N|--no-follow]    One service (default: app)
  logs <project> [svc...] [-N|--no-follow] All or selected services
  start, up            Start services
  restart, reload      Restart services
  recreate, rebuild    Run down followed by up -d (does not build images)
  stop                 Stop services
  remove, down         Stop and remove services
  purge                Remove containers and Compose volumes (confirmation required)
  pause, halt          Pause services
  unpause, unhalt      Resume paused services
  pull                 Pull images
  mod                  Edit COMP itself

Log examples:
  $0 log vikunja            Follow the app service
  $0 log vikunja db         Follow the db service
  $0 logs vikunja           Follow all services
  $0 logs vikunja app db    Follow app and db services
  $0 log vikunja db -N      Show db logs once, then exit
  $0 logs vikunja --no-follow Show all logs once, then exit
  Logs follow continuously by default; press Ctrl+C to stop.

Supported Compose files (first match wins):
  docker-compose.yml, docker-compose.yaml, compose.yml, compose.yaml
HELP
        ;;
    *)
        require_projects
        for i in "${name[@]}"; do docker "$parameter" "$i"; done
        ;;
esac
